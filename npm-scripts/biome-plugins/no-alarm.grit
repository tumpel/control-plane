language js(typescript)

or {
  `setAlarm`,
  JsMethodClassMember(name=`alarm`) as $method where { $method <: not within JsClassDeclaration(id=`Tenant`) }
} as $found where {
  register_diagnostic(span=$found, message="No alarms: send inline, check expiry at read time, and let a failure fail.", severity="error")
}

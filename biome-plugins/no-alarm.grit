language js

or {
  `$target.setAlarm($args)`,
  `class $name { $body }`,
  `class $name extends $base { $body }`
} as $found where {
  or { $found <: `$target.setAlarm($args)`, and { $name <: r"Tenant\w*", $body <: r"(?s).*\balarm\s*\(.*" } },
  register_diagnostic(span=$found, message="The Tenant stores business data, not timers: no setAlarm and no alarm() on the Tenant. Send inline, check expiry at read time, and let a failure fail.", severity="error")
}

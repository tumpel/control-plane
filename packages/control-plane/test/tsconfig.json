{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023", "es2024.string", "dom"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "erasableSyntaxOnly": true,
    "types": ["node"],
    "allowImportingTsExtensions": true
  },
  "include": ["."],
  "exclude": ["fixtures/*.ts"]
}

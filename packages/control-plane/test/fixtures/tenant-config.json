{
  "personas": [
    {
      "name": "Reviewer",
      "harness": "ClaudeCode",
      "secretSetName": "prod",
      "files": [
        {
          "path": ".claude/CLAUDE.md",
          "from": "reviewer/CLAUDE.md"
        },
        {
          "path": ".claude/settings.json",
          "from": "reviewer/settings.json"
        }
      ]
    }
  ],
  "secretSets": [
    {
      "name": "prod",
      "secrets": [
        {
          "kind": "ApiKey",
          "name": "ANTHROPIC_API_KEY",
          "provider": "Anthropic",
          "valueFrom": {
            "env": "TUMPEL_E2E_ANTHROPIC_KEY"
          }
        }
      ]
    }
  ],
  "harnessPins": [
    {
      "harness": "ClaudeCode",
      "harnessVersion": "2.1.325"
    }
  ],
  "hosts": []
}

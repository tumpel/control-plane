{
  "$schema": "https://raw.githubusercontent.com/mvhenten/tumpel/main/packages/api/generated/TenantConfig.json",
  "personas": [
    {
      "name": "Reviewer",
      "harness": "ClaudeCode",
      "secretSetName": "prod",
      "gitAuthorName": "Reviewer",
      "gitAuthorEmail": "reviewer@example.test",
      "files": [
        {
          "path": ".claude/CLAUDE.md",
          "from": "reviewer/CLAUDE.md"
        },
        {
          "path": ".claude/settings.json",
          "from": "reviewer/settings.json"
        }
      ]
    }
  ],
  "secretSets": [
    {
      "name": "prod",
      "secrets": [
        {
          "kind": "ApiKey",
          "name": "ANTHROPIC_API_KEY",
          "provider": "Anthropic",
          "valueFrom": {
            "env": "TUMPEL_E2E_ANTHROPIC_KEY"
          }
        }
      ]
    }
  ],
  "harnessPins": [
    {
      "harness": "ClaudeCode",
      "harnessVersion": "2.0.0"
    }
  ],
  "hosts": []
}

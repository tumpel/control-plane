{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tumpel-control-plane",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "observability": { "enabled": true },
  "limits": { "cpu_ms": 30 },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tumpel",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "STORE", "bucket_name": "tumpel-sessions" },
    { "binding": "RELEASES", "bucket_name": "tumpel-releases" }
  ],
  "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "tumpel_metrics" }],
  "queues": {
    "consumers": [
      { "queue": "tumpel-releases", "max_batch_size": 10, "max_retries": 0, "dead_letter_queue": "tumpel-releases-dlq" }
    ]
  },
  "vars": {
    "R2_BUCKET_NAME": "tumpel-sessions",
    "RELEASES_BUCKET_NAME": "tumpel-releases",
    "METRICS_DATASET": "tumpel_metrics",
    "GITHUB_API_ORIGIN": "https://api.github.com",
    "GITHUB_WEB_ORIGIN": "https://github.com",
    "OPENROUTER_ORIGIN": "https://openrouter.ai",
    "TUMPEL_LIMITS": {
      "defaultTier": "Configured",
      "freeTenantsPerAccount": 1,
      "configured": [
        { "measure": "RowsWritten", "window": "Hour", "limit": 3300000 },
        { "measure": "RowsRead", "window": "Hour", "limit": 100000000 }
      ],
      "readsPerMinute": 600,
      "writesPerMinute": 120,
      "hostFramesPerMinute": 600,
      "ceiling": {
        "writesPerMinute": 120,
        "hostFramesPerMinute": 600,
        "usage": [
          { "measure": "RowsWritten", "window": "Hour", "limit": 3300000 },
          { "measure": "RowsRead", "window": "Hour", "limit": 100000000 }
        ]
      }
    },
    "TUMPEL_SETTINGS": {
      "dispatchGrantTtlSeconds": 300,
      "snapshotDelaySeconds": 30,
      "snapshotDeadlineSeconds": 900,
      "turnOfferTtlSeconds": 60,
      "turnImageFetchBudgetSeconds": 900,
      "turnFirstLineBudgetSeconds": 120,
      "turnTotalBudgetSeconds": 3600,
      "transcriptChunkLines": 64,
      "prebuildUploadBudgetSeconds": 3600,
      "prebuildDispatchBudgetSeconds": 600,
      "prebuildBuildBudgetSeconds": 3600,
      "claudeSetupUrlBudgetSeconds": 300,
      "claudeSetupCodeBudgetSeconds": 600,
      "claudeSetupMintBudgetSeconds": 120,
      "claudeSetupMintGraceSeconds": 10,
      "heartbeatIntervalSeconds": 10,
      "heartbeatDeadlineSeconds": 30,
      "devicePollIntervalSeconds": 5,
      "deviceSlowDownStepSeconds": 5,
      "gitHubActionsIssuer": "https://token.actions.githubusercontent.com"
    }
  },
  "ratelimits": [
    { "name": "TENANT_READ_RATE", "namespace_id": "1001", "simple": { "limit": 600, "period": 60 } },
    { "name": "TENANT_WRITE_RATE", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } },
    { "name": "WEBHOOK_RATE", "namespace_id": "1004", "simple": { "limit": 600, "period": 60 } }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "TENANT", "class_name": "Tenant" },
      { "name": "HOST", "class_name": "HostChannel" },
      { "name": "SESSION_TIMER", "class_name": "SessionTimer" },
      { "name": "TENANT_METRICS", "class_name": "TenantMetrics" },
      { "name": "EVENTS", "class_name": "EventChannel" },
      { "name": "WEBHOOKS", "class_name": "WebhookSender" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Tenant"] },
    { "tag": "v2", "new_sqlite_classes": ["HostChannel"] },
    { "tag": "v3", "new_sqlite_classes": ["SessionTimer"] },
    { "tag": "v4", "new_sqlite_classes": ["TenantMetrics"] },
    { "tag": "v5", "new_sqlite_classes": ["EventChannel"] },
    { "tag": "v6", "new_sqlite_classes": ["WebhookSender"] }
  ],
  "rules": [{ "type": "Text", "globs": ["**/*.sql", "**/*.css", "**/*.sh", "**/*.jsonc"], "fallthrough": true }],
  "env": {
    "dev": {
      "limits": { "cpu_ms": 30 },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tumpel",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "STORE", "bucket_name": "tumpel-sessions-dev" },
        { "binding": "RELEASES", "bucket_name": "tumpel-releases-dev" }
      ],
      "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "tumpel_metrics_dev" }],
      "queues": {
        "consumers": [
          {
            "queue": "tumpel-releases-dev",
            "max_batch_size": 10,
            "max_retries": 0,
            "dead_letter_queue": "tumpel-releases-dev-dlq"
          }
        ]
      },
      "vars": {
        "R2_BUCKET_NAME": "tumpel-sessions-dev",
        "RELEASES_BUCKET_NAME": "tumpel-releases-dev",
        "METRICS_DATASET": "tumpel_metrics_dev",
        "GITHUB_API_ORIGIN": "https://api.github.com",
        "GITHUB_WEB_ORIGIN": "https://github.com",
        "OPENROUTER_ORIGIN": "https://openrouter.ai",
        "TUMPEL_LIMITS": {
          "defaultTier": "Configured",
          "freeTenantsPerAccount": 1,
          "configured": [
            { "measure": "RowsWritten", "window": "Hour", "limit": 3300000 },
            { "measure": "RowsRead", "window": "Hour", "limit": 100000000 }
          ],
          "readsPerMinute": 600,
          "writesPerMinute": 120,
          "hostFramesPerMinute": 600,
          "ceiling": {
            "writesPerMinute": 120,
            "hostFramesPerMinute": 600,
            "usage": [
              { "measure": "RowsWritten", "window": "Hour", "limit": 3300000 },
              { "measure": "RowsRead", "window": "Hour", "limit": 100000000 }
            ]
          }
        },
        "TUMPEL_SETTINGS": {
          "dispatchGrantTtlSeconds": 300,
          "snapshotDelaySeconds": 30,
          "snapshotDeadlineSeconds": 900,
          "turnOfferTtlSeconds": 60,
          "turnImageFetchBudgetSeconds": 900,
          "turnFirstLineBudgetSeconds": 120,
          "turnTotalBudgetSeconds": 3600,
          "transcriptChunkLines": 64,
          "prebuildUploadBudgetSeconds": 3600,
          "prebuildDispatchBudgetSeconds": 600,
          "prebuildBuildBudgetSeconds": 3600,
          "claudeSetupUrlBudgetSeconds": 300,
          "claudeSetupCodeBudgetSeconds": 600,
          "claudeSetupMintBudgetSeconds": 120,
          "claudeSetupMintGraceSeconds": 10,
          "heartbeatIntervalSeconds": 10,
          "heartbeatDeadlineSeconds": 30,
          "devicePollIntervalSeconds": 5,
          "deviceSlowDownStepSeconds": 5,
          "gitHubActionsIssuer": "https://token.actions.githubusercontent.com"
        }
      },
      "ratelimits": [
        { "name": "TENANT_READ_RATE", "namespace_id": "2001", "simple": { "limit": 600, "period": 60 } },
        { "name": "TENANT_WRITE_RATE", "namespace_id": "2002", "simple": { "limit": 120, "period": 60 } },
        { "name": "WEBHOOK_RATE", "namespace_id": "2004", "simple": { "limit": 600, "period": 60 } }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "TENANT", "class_name": "Tenant" },
          { "name": "HOST", "class_name": "HostChannel" },
          { "name": "SESSION_TIMER", "class_name": "SessionTimer" },
          { "name": "TENANT_METRICS", "class_name": "TenantMetrics" },
          { "name": "EVENTS", "class_name": "EventChannel" },
          { "name": "WEBHOOKS", "class_name": "WebhookSender" }
        ]
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["Tenant"] },
        { "tag": "v2", "new_sqlite_classes": ["HostChannel"] },
        { "tag": "v3", "new_sqlite_classes": ["SessionTimer"] },
        { "tag": "v4", "new_sqlite_classes": ["TenantMetrics"] },
        { "tag": "v5", "new_sqlite_classes": ["EventChannel"] },
        { "tag": "v6", "new_sqlite_classes": ["WebhookSender"] }
      ]
    }
  }
}

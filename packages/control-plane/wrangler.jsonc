{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tumpel-control-plane",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tumpel",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "TENANT", "class_name": "Tenant" }, { "name": "HOST", "class_name": "HostChannel" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Tenant"] },
    { "tag": "v2", "new_sqlite_classes": ["HostChannel"] }
  ],
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }]
}

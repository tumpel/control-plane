{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!packages/control-plane/templates/**/devcontainer.jsonc"]
  },
  "plugins": [
    {
      "path": "./npm-scripts/biome-plugins/prose.grit",
      "includes": ["packages/control-plane/src/**/*.ts", "!packages/control-plane/src/**/*.test.ts"]
    },
    {
      "path": "./npm-scripts/biome-plugins/no-alarm.grit",
      "includes": [
        "packages/control-plane/**/*.ts",
        "!packages/control-plane/src/pack-cleanup.ts",
        "!packages/control-plane/test/scenarios/harness/runtime.ts"
      ]
    },
    {
      "path": "./npm-scripts/biome-plugins/no-sql-exec.grit",
      "includes": [
        "packages/control-plane/src/**/*.ts",
        "!packages/control-plane/src/connector-rows.ts",
        "!packages/control-plane/src/durable-migrate.ts",
        "!packages/control-plane/src/host-channel.ts",
        "!packages/control-plane/src/metrics-query.ts",
        "!packages/control-plane/src/metrics-store.ts",
        "!packages/control-plane/src/supervisor-updates.ts",
        "!packages/control-plane/src/tenant-claude-setups.ts",
        "!packages/control-plane/src/tenant-connectors.ts",
        "!packages/control-plane/src/tenant-events.ts",
        "!packages/control-plane/src/tenant-openrouter-authorizations.ts",
        "!packages/control-plane/src/tenant-prebuilds.ts",
        "!packages/control-plane/src/tenant-push-subscriptions.ts",
        "!packages/control-plane/src/tenant-sessions.ts",
        "!packages/control-plane/src/tenant-subscriptions.ts",
        "!packages/control-plane/src/tenant-triggers.ts",
        "!packages/control-plane/src/tenant-webhooks.ts",
        "!packages/control-plane/src/tenant.ts"
      ]
    }
  ],
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noEmptyBlockStatements": "error"
      },
      "style": {
        "noNonNullAssertion": "error"
      },
      "complexity": {
        "noUselessCatch": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
